@model MvcOnlineTicariOtomasyon.Models.Siniflar.Class4

@{
    ViewBag.Title = "Dinamik";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<br />
<br />

<div class="panel panel-default">
    <div class="panel-heading">
        <div class="row">
            <h2 class="panel-title pull-left" style="margin-left:10px;">
                <strong>Fatura & Kalem İşlemleri</strong>
            </h2>
            <button style="margin-right:10px" class="btn btn-primary pull-right" onclick="addNewOrder()">Fatura Girişi</button>
        </div>
    </div>
    @*Fatura Listesi*@
    @foreach (var item in Model.deger1)
    {
        <div class="panel-body">
            <table class="table table-striped table-responsive">
                <tbody>
                    <tr>
                        <td>Seri - Sıra No : @item.FaturaSeriNo - @item.FaturaSıraNo </td>
                        <td>Teslim Eden : @item.TeslimEden</td>
                        <td>Tarih : @item.Tarih</td>
                        <td>Vergi Dairesi : @item.VergiDairesi</td>
                    </tr>
                    <tr>
                        <td colspan="4">
                            <table class="table table-bordered">
                                <tbody>
                                    <tr>
                                        <th>Açıklama</th>
                                        <th>Miktar</th>
                                        <th>Fiyat</th>
                                        <th>Tutar</th>
                                    </tr>

                                    @{
                                        var totalBill = 0;
                                    }

                                    @foreach (var order in item.FaturaKalems)
                                    {
                                        <tr>
                                            <td>@order.Aciklama</td>
                                            <td>@order.Miktar</td>
                                            <td>@order.BirimFiyat ₺</td>
                                            <td>@order.Tutar ₺</td>
                                        </tr>

                                        totalBill = totalBill + @Convert.ToInt32(order.Tutar);
                                    }
                                </tbody>
                            </table>

                            <span class="pull-right" style="margin-right:100px;"><strong>Fatura Toplam Tutarı:  </strong> @totalBill ₺</span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    }
</div>

@*Adım 2*@
<div class="modal fade" id="newOrderModal">
    <div class="modal-dialog modal-lg" style="width: 900px !important;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4>Yeni Fatura Girişi</h4>
            </div>
            <form id="NewOrderForm">
                <div class="modal-body">
                    <!-- Fatura Detayları -->
                    <h5 style="color:#ff6347">Fatura Detayları</h5>
                    <hr />
                    <div class="form-horizontal">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Seri No</label>
                                    <input type="text" id="FaturaSeriNo" name="FaturaSeriNo" placeholder="Seri Numarası" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Sıra No</label>
                                    <input type="text" id="FaturaSıraNo" name="FaturaSıraNo" placeholder="Sıra Numarası" class="form-control" />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Tarih</label>
                                    <input type="text" id="Tarih" name="Tarih" placeholder="Tarihi Giriniz" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Vergi Dairesi</label>
                                    <input type="text" id="VergiDairesi" name="VergiDairesi" placeholder="Vergi Dairesi" class="form-control" />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Saat</label>
                                    <input type="text" id="Saat" name="Saat" placeholder="Saati Giriniz" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Teslim Eden</label>
                                    <input type="text" id="TeslimEden" name="TeslimEden" placeholder="Teslim Eden Cari/Personel" class="form-control" />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Teslim Alan</label>
                                    <input type="text" id="TeslimAlan" name="TeslimAlan" placeholder="Teslim Alan Cari/Personel" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Toplam Tutar</label>
                                    <input type="text" id="Toplam" name="Toplam" placeholder="Toplam Tutar" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Fatura Kalemleri -->
                    <h5 style="margin-top:10px;color:#ff6347">Fatura Kalemleri</h5>
                    <hr />
                    <div class="form-horizontal">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Açıklama</label>
                                    <input type="text" id="Aciklama" name="Aciklama" placeholder="Ürün / Birim Açıklamasını Giriniz" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Fiyat</label>
                                    <input type="number" id="BirimFiyat" name="BirimFiyat" placeholder="Birim Fiyatını Giriniz" class="form-control" />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Miktar</label>
                                    <input type="number" id="Miktar" name="Miktar" placeholder="Miktar Giriniz" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-6 text-right">
                                <a id="addToList" class="btn btn-primary" style="margin-top: 25px;">Listeye Ekle</a>
                            </div>
                        </div>

                        <table id="detailsTable" class="table">
                            <thead>
                                <tr>
                                    <th style="width:30%">Açıklama</th>
                                    <th style="width:20%">Miktar</th>
                                    <th style="width:15%">Fiyat</th>
                                    <th style="width:25%">Tutar</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Pencereyi Kapat</button>
                    <button id="saveOrder" type="submit" class="btn btn-danger">Faturayı Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section scripts {
    <script>
        // Show Modal
        function addNewOrder() {
            $("#newOrderModal").modal("show");
        }

        // Modalı Kapatmak
        $(".btn-default[data-dismiss='modal']").click(function () {
            $("#newOrderModal").modal("hide");
        });

        // Close the modal when clicking the "X" button
        $(".close").click(function () {
            $("#newOrderModal").modal("hide");
        });

        // Add Multiple Order to the list
        $("#addToList").click(function (e) {
            e.preventDefault();

            if ($.trim($("#Aciklama").val()) == "" || $.trim($("#BirimFiyat").val()) == "" || $.trim($("#Miktar").val()) == "") return;

            var Aciklama = $("#Aciklama").val(),
                BirimFiyat = $("#BirimFiyat").val(),
                Miktar = $("#Miktar").val(),
                detailsTableBody = $("#detailsTable tbody");

            var degerler = '<tr><td>' + Aciklama + '</td><td>' + Miktar + '</td><td>' + BirimFiyat + '</td><td>' + (parseFloat(BirimFiyat) * parseInt(Miktar)) + '</td><td><a data-itemId="0" href="#" class="deleteItem">Remove</a></td></tr>';

            detailsTableBody.append(degerler);
            clearItem();
        });

        // Clear the input fields after adding item to the list
        function clearItem() {
            $("#Aciklama").val('');
            $("#BirimFiyat").val('');
            $("#Miktar").val('');
        }

        // Remove an item from the list
        $(document).on('click', 'a.deleteItem', function (e) {
            e.preventDefault();

            var $self = $(this);
            if ($(this).attr('data-itemId') == "0") {
                $(this).parents('tr').css("background-color", "#ff6347").fadeOut(800, function () {
                    $(this).remove();
                });
            }
        });

        // Save Order to database
        function saveOrder(data) {
            return $.ajax({
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                type: 'POST',
                url: "/Fatura/FaturaKaydet",  // Controller'daki endpoint
                data: data,
                success: function (result) {
                    alert(result);
                    location.reload();  // Sayfayı yenile
                },
                error: function () {
                    alert("Error!");
                }
            });
        }

        // Collect all order data and pass to the controller for saving
        $("#saveOrder").click(function (e) {
            e.preventDefault();

            var orderArr = [];
            orderArr.length = 0;

            $.each($("#detailsTable tbody tr"), function () {
                orderArr.push({
                    Aciklama: $(this).find('td:eq(0)').html(),
                    Miktar: $(this).find('td:eq(1)').html(),
                    BirimFiyat: $(this).find('td:eq(2)').html(),
                    Tutar: $(this).find('td:eq(3)').html()
                });
            });

            var data = JSON.stringify({
                FaturaSeriNo: $("#FaturaSeriNo").val(),
                FaturaSıraNo: $("#FaturaSıraNo").val(),
                Tarih: $("#Tarih").val(),
                Saat: $("#Saat").val(),
                VergiDairesi: $("#VergiDairesi").val(),
                TeslimEden: $("#TeslimEden").val(),
                TeslimAlan: $("#TeslimAlan").val(),
                Toplam: $("#Toplam").val(),
                kalemler: orderArr
            });

            $.when(saveOrder(data)).then(function (response) {
                console.log(response);
            }).fail(function (err) {
                console.log(err);
            });
        });
    </script>

}
