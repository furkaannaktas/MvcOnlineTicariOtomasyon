@model MvcOnlineTicariOtomasyon.Models.Siniflar.Departman
@{
    ViewBag.Title = "Departman Güncelleme";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

<script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>

<br />
<h2>Departman Güncelleme</h2>
<br />

<!-- Form başlatma -->
<form class="form-group" method="post" id="departmanForm">
    @Html.LabelFor(x => x.DepartmanAd)
    @Html.TextBoxFor(x => x.DepartmanAd, new { @class = "form-control" })
    @Html.HiddenFor(x => x.Departmanid)
    <br />
    <button type="submit" class="btn btn-warning" id="submitBtn">Güncelle</button>
</form>

<script>
    // Form gönderildiğinde
    $('#departmanForm').on('submit', function (event) {
        event.preventDefault(); // Formun otomatik gönderimini engeller

        // Formu AJAX ile gönder
        $.ajax({
            url: '@Url.Action("DepartmanGuncelle", "Departman")', // POST action URL
            type: 'POST',
            data: $(this).serialize(), // Form verilerini al
            success: function () {
                // Başarılı olduğunda SweetAlert mesajı göster
                swal({
                    title: "Başarılı!",
                    text: "Departman başarıyla güncellendi.",
                    icon: "success",
                    button: "Tamam",
                }).then(() => {
                    // Mesajdan sonra sayfayı yenile veya yönlendir
                    window.location.href = '@Url.Action("Index", "Departman")';
                });
            },
            error: function () {
                // Hata durumunda bir uyarı göster
                swal({
                    title: "Hata!",
                    text: "Departman güncellenirken bir hata oluştu.",
                    icon: "error",
                    button: "Tamam",
                });
            }
        });
    });
</script>
