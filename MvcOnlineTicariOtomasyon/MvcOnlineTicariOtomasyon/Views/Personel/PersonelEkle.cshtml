@model MvcOnlineTicariOtomasyon.Models.Siniflar.Personel
@{
    ViewBag.Title = "PersonelEkle";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

<script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>

<br />
<h2>Yeni Personel Sayfası</h2>
<br />
<form class="form-group" method="post" id="personelForm" enctype="multipart/form-data">
    @Html.LabelFor(x => x.PersonelAd)
    @Html.TextBoxFor(x => x.PersonelAd, new { @class = "form-control" })
    <br />
    @Html.LabelFor(x => x.PersonelSoyad)
    @Html.TextBoxFor(x => x.PersonelSoyad, new { @class = "form-control" })
    <br />
    @Html.LabelFor(x => x.PersonelGorsel)
    <input type="file" name="PersonelGorsel" />
    <br />
    @Html.LabelFor(x => x.Departman)
    @Html.DropDownListFor(x => x.Departmanid, (List<SelectListItem>)ViewBag.dgr1, new { @class = "form-control" })
    <br />
    <button type="submit" class="btn btn-info" id="submitBtn">Kaydet</button>
</form>

<script>
    // jQuery'nin hazır olduğunda çalışması için $(document).ready() kullanılıyor.
    $(document).ready(function () {
        $('#personelForm').on('submit', function (event) {
            event.preventDefault(); // Formun otomatik gönderimini engeller

            // Formu AJAX ile gönder
            $.ajax({
                url: '@Url.Action("PersonelEkle", "Personel")',
                type: 'POST',
                data: new FormData(this), // Form verilerini al
                processData: false,
                contentType: false,
                success: function () {
                    // Başarılı olduğunda SweetAlert mesajı göster
                    swal({
                        title: "Başarılı!",
                        text: "Yeni personel başarıyla eklendi.",
                        icon: "success",
                        button: "Tamam",
                    }).then(() => {
                        // Mesajdan sonra sayfayı yenile veya yönlendir
                        window.location.href = '@Url.Action("Index", "Personel")'; // Ana sayfaya yönlendirme
                    });
                }
            });
        });
    });
</script>
