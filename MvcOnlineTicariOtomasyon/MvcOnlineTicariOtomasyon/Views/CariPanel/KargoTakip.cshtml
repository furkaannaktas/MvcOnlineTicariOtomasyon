@using MvcOnlineTicariOtomasyon.Models.Siniflar
@model List<KargoDetay>
@{
    ViewBag.Title = "KargoTakip";
    Layout = "~/Views/Shared/_CariLayout.cshtml";
}

<br />
@using (Html.BeginForm("KargoTakip", "CariPanel", FormMethod.Get))
{
    <div class="input-group mb-3">
        <input type="text" name="p" class="form-control" placeholder="Kargo Takip Numarasını Giriniz" aria-label="Kargo Takip Numarası:" aria-describedby="search-addon">
        <div class="input-group-append">
            <button class="btn btn-dark" type="submit" id="search-addon">
                <i class="fa fa-search"></i> Ara
            </button>
        </div>
    </div>
}
<table class="table table-bordered" style="margin-top:20px">
    <tr>
        <th>Personel</th>
        <th>Alıcı</th>
        <th>Takip Kodu</th>
        <th>Tarih</th>
        <th>Detaylar</th>
    </tr>
    @foreach (var k in Model)
    {
        <tr>
            <td>@k.Personel</td>
            <td>@k.Alici</td>
            <td>@k.TakipKodu</td>
            <td>@k.Tarih</td>
            <td><a href="/CariPanel/CariKargoTakip/@k.TakipKodu" class="btn btn-default" style="background-color:lightcoral">Detaylar</a></td>
        </tr>
    }
</table>




