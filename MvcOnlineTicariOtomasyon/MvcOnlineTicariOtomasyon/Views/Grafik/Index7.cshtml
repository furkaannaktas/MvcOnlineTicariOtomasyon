@{
    ViewBag.Title = "Index7";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

<br />
<!DOCTYPE html>
<html lang="en">
<head>
    <title>Ürün Stok Grafiği Column</title>
    <script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/1.9.1/jquery.min.js"></script>
    <script>
        $(document).ready(function () {
            $.ajax({
                type: "POST",
                dataType: "json",
                contentType: "application/json",
                url: '@Url.Action("VisualizeUrunResult2", "Grafik")',
                success: function (result) {
                    console.log("Dönen Veri:", result); // Gelen veriyi kontrol edin
                    google.charts.load('current', { 'packages': ['corechart'] });
                    google.charts.setOnLoadCallback(function () {
                        drawChart(result);
                    });
                },
                error: function (xhr, status, error) {
                    console.error("AJAX Hatası:", error);
                }
            });
        });

        function drawChart(result) {
            var data = new google.visualization.DataTable();
            data.addColumn('string', 'Ürün Adı');
            data.addColumn('number', 'Stok Miktarı');

            var dataArray = [];
            $.each(result, function (i, obj) {
                if (obj.urn && obj.stk) {
                    dataArray.push([obj.urn, obj.stk]);
                }
            });

            console.log("Grafik Verisi:", dataArray);
            data.addRows(dataArray);

            var columnChartOptions = {
               // title: "Ürün - Stok Grafiği (Column)",
                width: 1300,
                height: 700,
               // hAxis: { title: "Ürün Adı" },
               // vAxis: { title: "Stok Miktarı" },
                bar: { groupWidth: "50%" }
            };

            var columnChart = new google.visualization.ColumnChart(
                document.getElementById('Columnchart_div')
            );

            columnChart.draw(data, columnChartOptions);
        }
    </script>
</head>
<body>
    <h2>Ürün - Stok Grafiği Column</h2>
    <div id="Columnchart_div" style="width: 1300px; height: 700px;"></div>
</body>
</html>
