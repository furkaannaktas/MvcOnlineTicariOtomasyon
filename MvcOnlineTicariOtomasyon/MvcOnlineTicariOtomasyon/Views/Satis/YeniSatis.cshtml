@model MvcOnlineTicariOtomasyon.Models.Siniflar.SatisHareket
@{
    ViewBag.Title = "Yeni Satış";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

<script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>

<br />
<h2>Yeni Satış Sayfası</h2>
<br />
<form class="form-group" method="post" id="satisForm">
    @Html.LabelFor(x => x.Urun)
    @Html.DropDownListFor(x => x.Urunid, (List<SelectListItem>)ViewBag.dgr1, new { @class = "form-control" })
    <br />
    @Html.Label("Cari")
    @Html.DropDownListFor(x => x.Cariid, (List<SelectListItem>)ViewBag.dgr2, new { @class = "form-control" })
    <br />
    @Html.LabelFor(x => x.Personel)
    @Html.DropDownListFor(x => x.Personelid, (List<SelectListItem>)ViewBag.dgr3, new { @class = "form-control" })
    <br />
    @Html.LabelFor(x => x.Adet)
    @Html.TextBoxFor(x => x.Adet, new { @class = "form-control" })
    <br />
    @Html.LabelFor(x => x.Fiyat)
    @Html.TextBoxFor(x => x.Fiyat, new { @class = "form-control" })
    <br />
    @Html.LabelFor(x => x.ToplamTutar)
    @Html.TextBoxFor(x => x.ToplamTutar, new { @class = "form-control" })
    <br />
    <button type="submit" class="btn btn-info" id="submitBtn">Satış Yap</button>
</form>

<script>
    $(document).ready(function () {
        $('#satisForm').on('submit', function (event) {
            event.preventDefault(); // Formun otomatik gönderimini engeller

            // Formu AJAX ile gönder
            $.ajax({
                url: '@Url.Action("YeniSatis", "Satis")',
                type: 'POST',
                data: new FormData(this), // Form verilerini al
                processData: false,
                contentType: false,
                success: function () {
                    // Başarılı olduğunda SweetAlert mesajı göster
                    swal({
                        title: "Başarılı!",
                        text: "Satış başarıyla yapıldı.",
                        icon: "success",
                        button: "Tamam",
                    }).then(() => {
                        // Mesajdan sonra sayfayı yönlendir
                        window.location.href = '@Url.Action("Index", "Satis")'; // Satışlar sayfasına yönlendirme
                    });
                }
            });
        });
    });
</script>
